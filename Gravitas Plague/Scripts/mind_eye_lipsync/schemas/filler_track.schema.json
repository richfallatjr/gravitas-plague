{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "trackVersion", "compilerVersion", "fillerID", "speakerCharacterID", "audioResourcePath", "audioSHA256", "descriptorSHA256", "authoring", "timeline", "mouthLayerBits", "poseRuns", "expandedFramesSHA256", "analysisProvenance", "summary"],
  "properties": {
    "schemaVersion": {"const": 1},
    "trackVersion": {"const": "mind-eye-filler-track/1"},
    "compilerVersion": {"const": "mind-eye-filler-compiler/1.0.0"},
    "fillerID": {"type": "string", "minLength": 1},
    "speakerCharacterID": {"enum": ["big_mike", "rich"]},
    "audioResourcePath": {"type": "string"},
    "audioSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "descriptorSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authoring": {"type": "object"},
    "timeline": {"type": "object"},
    "mouthLayerBits": {"const": {"rest": 1, "small": 2, "wide": 4, "round": 8, "teeth": 16}},
    "poseRuns": {"type": "array", "minItems": 1},
    "expandedFramesSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysisProvenance": {"type": "object"},
    "summary": {"type": "object"}
  }
}
